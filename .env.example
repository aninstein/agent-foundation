# Choose exactly one deployment path with ./scripts/up.sh local|external.
APP_PORT=8787
APP_DATA_DIR=/app/data
DEER_FLOW_DATE_TIMEZONE=Asia/Shanghai

# Required at deployment. Set both privately; the repository contains no default account.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=

# The model list contains references to key variable names, never key values.
# local mode uses the Compose Ollama service. Replace the model ID if desired.
MODEL_CONFIG_JSON='[{"provider":"ollama","model":"qwen2.5:3b","base_url":"http://ollama:11434"}]'
PRIMARY_MODEL=qwen2.5:3b
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=45

# external mode example:
# MODEL_CONFIG_JSON='[{"provider":"openai","model":"your-model-id","base_url":"https://your-provider.example/v1","api_key_env":"MODEL_API_KEY"}]'
# PRIMARY_MODEL=your-model-id
MODEL_API_KEY=

# Optional OpenAI-compatible speech endpoints. Leave disabled for text-only apps.
VOICE_STT_BASE_URL=
VOICE_STT_MODEL=
VOICE_STT_API_KEY_ENV=VOICE_API_KEY
VOICE_TTS_BASE_URL=
VOICE_TTS_MODEL=
VOICE_TTS_VOICE=alloy
VOICE_TTS_API_KEY_ENV=VOICE_API_KEY
VOICE_API_KEY=
